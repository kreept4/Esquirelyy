# Supabase — get these from supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Resend — get from resend.com → API Keys
RESEND_API_KEY=re_your_key_here

# Application tracker email domain
# Set up a catch-all address on Resend that forwards to your webhook
TRACKER_EMAIL_DOMAIN=mail.esquirely.app

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Anthropic (for AI features)
ANTHROPIC_API_KEY=your-anthropic-key-here
# Transactional email (Brevo). Server-only — never prefix with NEXT_PUBLIC_.
# Free tier: 300/day, single verified sender address, no domain needed.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Esquirely
# Used for absolute links inside emails.
NEXT_PUBLIC_SITE_URL=

# ── The opportunities agent ────────────────────────────────────────────────
# Finds roles and scholarships, proposes them in Telegram, and only acts when
# you tap Approve. Set these in Vercel too, not just locally — the scheduled
# sweep runs there. See scripts/2026-08-15-agent-schema.sql for the tables.

# From @BotFather. SERVER ONLY — this token can send as the bot and read every
# message in the chat, so it must never carry a NEXT_PUBLIC_ prefix.
TELEGRAM_BOT_TOKEN=

# Any string you invent. Telegram sends it back on every webhook delivery, and
# the route rejects anything without it — this is what stops a stranger who
# guesses the URL from POSTing a forged update that claims to be from you.
# Generate one with:  openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Who may command the bot. Send /whoami to the bot and it replies with the
# number. Comma-separated for more than one.
#
# ⚠ SET THIS. With neither this nor the username list below, the bot answers
# nobody — which is the intended failure. A Telegram bot has no access control
# of its own: anyone who finds its @name can message it, and without this gate
# they could approve their own listings onto your board.
TELEGRAM_ALLOWED_CHAT_IDS=

# A weaker bootstrap for before you know your chat id. A username can be
# released and re-registered by someone else, who would inherit the bot — so
# move to the chat id above and clear this once /whoami has told you the number.
TELEGRAM_ALLOWED_USERNAMES=ThisisKreept

# Where the scheduled sweep reports. Usually the same as your chat id.
TELEGRAM_CHAT_ID=

# Vercel sends this as `Authorization: Bearer <secret>` on every scheduled run,
# and /api/agent/sweep rejects anything else. Without it, a stranger who guesses
# the path can make the agent spend money on web searches, repeatedly.
# Generate one with:  openssl rand -hex 32
CRON_SECRET=

# OPTIONAL. r.jina.ai renders JavaScript, and the agent falls back to it when a
# direct fetch is blocked or the page is an empty React shell.
#
# ⚠ ANONYMOUS r.jina.ai NO LONGER WORKS. Tested 15 August 2026: it returns 403
# to everything without a key, including example.com — so the free
# `curl https://r.jina.ai/URL` that circulates in tutorials is dead. The agent
# skips the fallback entirely when this is unset rather than burning a 20-second
# timeout per page to rediscover that.
#
# Leaving it blank is fine. Direct fetch reached every source tried except the
# African Development Bank, which is genuinely behind a Cloudflare challenge.
# Get a key at jina.ai if you want that last slice of coverage.
JINA_API_KEY=
