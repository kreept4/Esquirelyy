# Supabase — get these from supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Resend — get from resend.com → API Keys
RESEND_API_KEY=re_your_key_here

# Application tracker email domain
# Set up a catch-all address on Resend that forwards to your webhook
TRACKER_EMAIL_DOMAIN=mail.esquirely.app

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Anthropic (for AI features)
ANTHROPIC_API_KEY=your-anthropic-key-here
